{
  "name": "cassini-live-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Cassini Live transcript panel for Nextcloud Talk — bookmarklet + ExApp-served bundle",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "check:build": "node scripts/build.js --check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "serve:fixture": "node tests/fixture-server.mjs",
    "replay": "node replay/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "^0.24.0",
    "terser": "^5.36.0"
  }
}
